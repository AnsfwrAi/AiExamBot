# --- DOMAIN SETTINGS (Used by Caddy and Django) ---
# The domain where the bot API is accessible. Caddy will use DOMAIN for SSL.
DOMAIN=bot.yourdomain.com
API_DOMAIN=https://bot.yourdomain.com

# --- TELEGRAM BOT CONFIGURATION ---
BOT_TOKEN=your_real_telegram_bot_token_here
BOT_USERNAME=your_bot_username_without_at

# --- WEBHOOK & WEB APP ENDPOINTS (Must use HTTPS and match your DOMAIN) ---
WEBHOOK_URL=https://bot.yourdomain.com/api/bot/webhook
GET_SCRIPT_URL=https://bot.yourdomain.com/api/v1/get_script
GET_SCRIPT_JS=https://bot.yourdomain.com
WEB_APP_SELECT_TIME_URL=https://bot.yourdomain.com/api/bot/select_time
WEB_APP_REDACT_TIME_URL=https://bot.yourdomain.com/api/bot/redact_time

# --- OPENAI API KEY ---
OPENAI_API_KEY=your_openai_api_key_here

# --- BASE SETTINGS ---
DEBUG=False
ALLOWED_HOSTS=bot.yourdomain.com,web,localhost

# --- DATABASE SETTINGS (Docker Compose db container credentials) ---
DB_TYPE=POSTGRES
POSTGRES_DB=answer_ai
POSTGRES_USER=answer_ai
POSTGRES_PASSWORD=choose_a_strong_password_here

# --- REFERRAL & CONSTANTS ---
REWERD_PER_REFFERAL=25_000
MAX_DISCOUNT=125_000
SCRIPT_BASE_PRICE=300_000

# --- OTHER SETTINGS ---
CARD_FOR_PAYMENT=9860 3511 4136 8927
NAME_CARD=IVANOV IVAN
VIDEO_INSTRUCTION_TG_ID_VIDEO_RU=asddhajkhasdjhksadjhksdajhksadhjk
VIDEO_INSTRUCTION_TG_ID_VIDEO_UZ=asddhajkhasdjhksadjhksdajhksadhjk
POLICE_FILE_TG_ID_DOCUMENT_RU=asddhajkhasdjhksadjhksdajhksadhjk
POLICE_FILE_TG_ID_DOCUMENT_UZ=asddhajkhasdjhksadjhksdajhksadhjk
